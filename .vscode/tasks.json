{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "Configure",
			"command": "configure",
			"preset": "${command:cmake.activeConfigurePresetName}",
			"problemMatcher": {
				"owner": "frugi",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			"detail": "CMake configure",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			}
		},
		{
			"type": "shell",
			"label": "Flash",
			"command": "${env:STM32CUBECLT_PATH}/STM32CubeProgrammer/bin/STM32_Programmer_CLI",
			"windows": {
				"command": "${env:STM32CUBECLT_PATH}/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe"
			},
			"args": [
				"-c",
				"port=JLink",
				"reset=SWrst",
				"-w",
				"${workspaceFolder}/build/${command:cmake.activeBuildPresetName}/build/source/app.elf",
				"-g"
			],
			"dependsOn": "Test, Build",
			"detail": "Flash device using J-Link probe",
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": false
			}
		},
		{
			"type": "cmake",
			"label": "Rebuild",
			"command": "cleanRebuild",
			"targets": [
				"all"
			],
			"preset": "${command:cmake.activeBuildPresetName}",
			"group": "build",
			"problemMatcher": {
				"owner": "frugi",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			"detail": "CMake clean and build",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": false
			}
		},
		{
			"type": "cmake",
			"label": "Build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "${command:cmake.activeBuildPresetName}",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": {
				"owner": "frugi",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			"detail": "CMake build",
			"presentation": {
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": false
			}
		},
		{
			"label": "Test",
			"type": "shell",
			"command": "cmake --preset test; cmake --build build/test; ctest --test-dir build/test --output-on-failure",
			"problemMatcher": {
				"owner": "frugi",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			"detail": "Unity tests",
			"presentation": {
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			}
		},
		{
			"type": "cmake",
			"label": "CMake: clean rebuild",
			"command": "cleanRebuild",
			"targets": [
				"all"
			],
			"preset": "${command:cmake.activeBuildPresetName}",
			"group": "build",
			"problemMatcher": {
				"owner": "frugi",
				"fileLocation": [
					"autoDetect",
					"${workspaceFolder}"
				],
				"pattern": {
					"regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			"detail": "CMake template clean rebuild task",
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			}
		}
	]
}
